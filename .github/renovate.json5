{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  // Best practices pin GitHub Actions to commit digests and keep lockfiles
  // exact. Go indirect dependencies get PRs only when they are vulnerable.
  "extends": [
    "config:best-practices",
    "mergeConfidence:all-badges",
    "security:gomodIndirectSecurityUpdates",
  ],
  "timezone": "America/New_York",
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "labels": ["renovate"],
  "assignees": ["nateships"],
  // Frontend and docs lockfiles are pnpm format; aube reads and writes them in
  // place. Renovate updates them with pnpm: pin the major aube targets, and skip
  // the dedupe pass, which aube already does and which is one more step that
  // can fail in Renovate's runner.
  "postUpdateOptions": ["gomodTidy"],
  "constraints": { "pnpm": "^10.0.0" },
  "automerge": true,
  "platformAutomerge": true,
  "customManagers": [
    {
      // The aube pin in docs/vercel.json (`aube@X.Y`). mise.toml's pin is
      // tracked by the mise manager; the rule below groups them into one PR.
      "customType": "regex",
      "managerFilePatterns": ["/^docs/vercel\\.json$/"],
      "matchStrings": ["aube@(?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)"],
      "depNameTemplate": "aube",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "jdx/aube",
      "extractVersionTemplate": "^v?(?<version>.*)$",
    },
    {
      // The goreleaser version the release workflow asks the action for.
      // mise.toml's pin is tracked by the mise manager; the rule below groups them.
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/release\\.yml$/"],
      "matchStrings": ["goreleaser/goreleaser-action@[^\\n]*\\n\\s+with:\\n\\s+version: v(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "goreleaser",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "goreleaser/goreleaser",
      "extractVersionTemplate": "^v(?<version>.*)$",
    },
  ],
  "packageRules": [
    {
      "description": "Major updates: manual review, never automerge",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["major-update"],
    },
    {
      "description": "Group every aube pin into one PR",
      "matchDepNames": ["aube"],
      "groupName": "aube",
    },
    {
      "description": "goreleaser in mise.toml and in the release workflow move together",
      "matchDepNames": ["goreleaser", "goreleaser/goreleaser"],
      "groupName": "goreleaser",
    },
    {
      "description": "Wails Go module, CLI, and JS runtime move together",
      "matchDepNames": ["github.com/wailsapp/wails/v3", "go:github.com/wailsapp/wails/v3/cmd/wails3", "@wailsio/runtime"],
      "groupName": "wails",
      "automerge": false,
    },
    {
      "description": "Finished or slow-moving deps that are not abandoned: uuid has nothing left to release, shellcheck releases about once a year",
      "matchDepNames": ["github.com/google/uuid", "shellcheck"],
      "abandonmentThreshold": null,
    },
    {
      "description": "Indirect Go deps: skip abandonment flagging (transitive, not ours to replace)",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "abandonmentThreshold": null,
    },
  ],
}
